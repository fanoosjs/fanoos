{
  "name": "@fanoosjs/cli",
  "version": "0.1.0",
  "description": "Command-line interface for static JavaScript analysis with Fanoos",
  "type": "module",
  "bin": {
    "fanoos": "./bin/fanoos.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fanoosjs/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^8.1.5"
  }
}
