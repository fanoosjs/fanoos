{
  "name": "@fanoosjs/ui",
  "version": "0.1.0",
  "description": "Fanoos UI components and Nuxt integration for interactive JavaScript analysis",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/module.ts",
      "development": "./src/module.ts",
      "import": "./dist/module.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fanoosjs/core": "workspace:*",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@vue-flow/background": "catalog:",
    "@vue-flow/controls": "catalog:",
    "@vue-flow/core": "catalog:",
    "@vue-flow/minimap": "catalog:",
    "elkjs": "catalog:",
    "h3": "catalog:",
    "lucide-vue-next": "catalog:",
    "nitropack": "catalog:",
    "shiki": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nuxt/module-builder": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@vue/test-utils": "catalog:",
    "nuxt": "catalog:",
    "typescript": "~5.9.3",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  }
}
